<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Text label where the typed text and the word count result are shown. -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tekstas bus rodomas čia"
            android:textSize="18sp"
            android:layout_marginBottom="32dp" />

        <!-- Three buttons: enter text, count words, share text. -->
        <Button
            android:id="@+id/btnEnterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Įvesti norimą tekstą" />

        <Button
            android:id="@+id/btnCountWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suskaičiuoti žodžius" />

        <Button
            android:id="@+id/btnShareText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siųsti tekstą su rezultatais" />

    </LinearLayout>

</FrameLayout>
